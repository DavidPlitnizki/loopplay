# ─── Ports ────────────────────────────────────────────────────────────────────
# lobby (Next.js) runs on 3000 by default — no var needed

# Games
GAME_21BOOM_PORT=3001
GAME_SPEED_QUIZ_PORT=3002
GAME_WORD_SNIPER_PORT=3003
GAME_CHAIN_REACTION_PORT=3004

# API (Hono)
API_PORT=4000

# ─── Lobby public URLs (consumed by Next.js via NEXT_PUBLIC_*) ─────────────────
NEXT_PUBLIC_GAME_21BOOM_URL=http://localhost:3001
NEXT_PUBLIC_GAME_SPEED_QUIZ_URL=http://localhost:3002
NEXT_PUBLIC_GAME_WORD_SNIPER_URL=http://localhost:3003
NEXT_PUBLIC_GAME_CHAIN_REACTION_URL=http://localhost:3004

NEXT_PUBLIC_API_URL=http://localhost:4000
